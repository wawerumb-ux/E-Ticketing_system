# ==============================================================================
# Docker Environment — copy to .env and fill in values
# ==============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=<SET_IN_ENV>
MYSQL_DATABASE=ict_ticketing

# ---- Database URL resolution (see backend/app.py get_database_uri) ----
# The app takes the FIRST of these that is set and non-empty:
#   1. SUPABASE_DATABASE_URL
#   2. DATABASE_URL
#   3. MYSQL_URL                    <- Railway injects this on the app service
#   4. MYSQLHOST / RAILWAY_PRIVATE_DOMAIN + MYSQLUSER + MYSQLPASSWORD
#      (or MYSQL_ROOT_PASSWORD) + MYSQLDATABASE / MYSQL_DATABASE + MYSQLPORT
#   5. mysql+pymysql://root:@127.0.0.1:3306/ict_ticketing   (local XAMPP)
# A bare "mysql://" scheme is rewritten to "mysql+pymysql://" automatically, and
# a MYSQL_URL left un-interpolated (still containing ${{ ... }}) is ignored in
# favour of the discrete variables above.
# Leave ALL of these blank to use the local XAMPP default.
SUPABASE_DATABASE_URL=
DATABASE_URL=
MYSQL_URL=
MYSQLHOST=
RAILWAY_PRIVATE_DOMAIN=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# ==============================================================================
# Flask
# ==============================================================================

# ---- SECRET_KEY / JWT_SECRET_KEY — MANDATORY, ROTATE PER ENVIRONMENT -------
#
# Two separate secrets, for two separate jobs:
#   SECRET_KEY      signs Flask session cookies
#   JWT_SECRET_KEY  signs the access/refresh tokens in sessionStorage
# They must NOT be the same string.
#
# Generate each one (run twice, use one output per variable):
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# -> 64 characters, ~384 bits. No quotes needed; avoid spaces and #.
#
# WHERE EACH ONE IS SET:
#   local venv      backend/.env   (already populated with working values --
#                   do not copy this file over it, or local logins reset)
#   local Docker    .env at repo root (compose reads it via env_file)
#   Railway         Service dashboard -> Variables -> add/rotate there.
#                   THIS IS THE ONE THAT MATTERS FOR THE DEPLOY.
#
# WHY YOU CANNOT LEAVE THESE BLANK OR USE A PLACEHOLDER:
# backend/helpers.py resolve_secret() accepts ANY non-empty string -- there is
# no length check and no placeholder detection. So a weak value does not crash
# the app, it silently ships a forgeable one. Flask's own docs use
# "TypeALongRandomStringHereForFlask" as the example value; a token signed with
# that string is accepted as a full admin session by anyone who has read the
# docs. Leaving a variable EMPTY is strictly safer than setting it to a
# placeholder -- resolve_secret() then generates a random secret at startup
# (secure, but every restart invalidates all sessions).
#
# TO ROTATE LATER: change the value in the Railway dashboard and redeploy. All
# existing sessions and tokens signed with the old value are invalidated
# immediately -- every user must log in again. That is the intended effect.
#
# VERIFY IT TOOK: after redeploying, the boot log must NOT contain
# "SECRET_KEY is not set - using a random secret generated at startup".
SECRET_KEY=<SET_IN_ENV>
JWT_SECRET_KEY=<SET_IN_ENV>

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. For single-host LAN
# deployments leave the default local origins below. For public deployments set it
# to the exact host(s) serving the frontend, e.g. https://app.example.com
# On Railway this MUST be your public domain (e.g. https://your-app.up.railway.app)
# or the browser blocks every API call from the deployed frontend.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000
FLASK_DEBUG=false
GUNICORN_WORKERS=4

# ---- Public URL -------------------------------------------------------------
# Used to build password-reset links. Must be the public origin of the running
# app, or reset emails link to localhost and the link is useless.
PUBLIC_URL=http://localhost:5000

# ---- Attachments ----
# Path where ticket attachments are stored (mounted as a named volume in Docker).
UPLOAD_FOLDER=/app/uploads

# ---- Email (SMTP) ----
# Leave blank to fall back to logging email contents to the server console
# instead of sending. Configure these to enable real password-reset and
# notification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=no-reply@example.com

# ---- Inbound email (IMAP) — turns incoming mail into tickets ----
# Requires a mailbox whose UNSEEN messages become tickets/comments, and the
# "inbound_email_enabled: yes" setting toggled in the admin Settings page.
# Set MAIL_INBOUND_ENABLED=true (env) OR the DB setting to turn it on.
MAIL_INBOUND_HOST=
MAIL_INBOUND_PORT=993
MAIL_INBOUND_USER=
MAIL_INBOUND_PASSWORD=
MAIL_INBOUND_FOLDER=INBOX
MAIL_INBOUND_ENABLED=false

# ---- OAuth (optional, leave blank to disable social login) ----
OAUTH_REDIRECT_URI=<SET_IN_ENV>

# ---- Cloudflare Turnstile (CAPTCHA on login and reset) ----
# Get keys at: https://dash.cloudflare.com → Turnstile
# Leave CF_TURNSTILE_SECRET_KEY empty to disable verification in dev.
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=
CF_TURNSTILE_ENABLED=true

# ---- Cloudflare Tunnel ----
# DEFAULT (free): cloudflared runs a quick tunnel and shows a random
# *.trycloudflare.com URL in the container logs. No token required.
# CUSTOM DOMAIN (IDLE — costs money when enabled): set CUSTOM_DOMAIN_ENABLED=true
# below AND provide a named-tunnel token here.
CF_TUNNEL_TOKEN=

# ---- Backups ----
BACKUP_DIR=/var/backups/ict_ticketing

# ==============================================================================
# IDLE — costs money when enabled
# ------------------------------------------------------------------------------
# Every flag below ships DISABLED (false). The component's code still exists
# and is wired in, but it short-circuits before making any paid network call,
# consumes no paid resource, and needs no credentials. Set the flag to "true"
# to activate.
# ==============================================================================

# Nightly offsite copy of the newest local backup (via rclone; b2 = Backblaze B2).
# Approximate cost when enabled: provider storage (pay-per-GB) + egress.
OFFSITE_BACKUP_ENABLED=false
OFFSITE_BACKUP_PROVIDER=b2          # rclone remote name (create it with `rclone config`)
OFFSITE_BACKUP_REMOTE=b2:ict-backups

# Custom domain for the Cloudflare tunnel (subscription/free-tier limits).
# Approximate cost when enabled: ~$5/mo or Cloudflare free-tier limits.
CUSTOM_DOMAIN_ENABLED=false

# Sends app events to MONITORING_ENDPOINT when enabled (monitoring_hook.py).
# Approximate cost when enabled: the monitoring provider you point at.
MONITORING_ENABLED=false
MONITORING_ENDPOINT=                # e.g. https://your-host.example/v1/events
MONITORING_API_KEY=                 # optional, only if the endpoint requires it

# PAID web-push notifications (frontend idle stub, maybePushNotify).
# Approximate cost when enabled: push provider (e.g. OneSignal/APNs) fees.
PUSH_ENABLED=false
