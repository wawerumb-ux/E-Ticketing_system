# ==============================================================================
# Docker Environment — copy to .env and fill in values
# ==============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=<SET_IN_ENV>
MYSQL_DATABASE=ict_ticketing

# ---- Flask ----
SECRET_KEY=<SET_IN_ENV>
JWT_SECRET_KEY=<SET_IN_ENV>
FLASK_DEBUG=false
GUNICORN_WORKERS=4

# ---- Public URL (used to build password-reset links) ----
PUBLIC_URL=http://localhost:5000

# ---- Attachments ----
# Path where ticket attachments are stored (mounted as a named volume in Docker).
UPLOAD_FOLDER=/app/uploads

# ---- Email (SMTP) ----
# Leave blank to fall back to logging email contents to the server console
# instead of sending. Configure these to enable real password-reset and
# notification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=no-reply@example.com

# ---- Inbound email (IMAP) — turns incoming mail into tickets ----
# Requires a mailbox whose UNSEEN messages become tickets/comments, and the
# "inbound_email_enabled: yes" setting toggled in the admin Settings page.
# Set MAIL_INBOUND_ENABLED=true (env) OR the DB setting to turn it on.
MAIL_INBOUND_HOST=
MAIL_INBOUND_PORT=993
MAIL_INBOUND_USER=
MAIL_INBOUND_PASSWORD=
MAIL_INBOUND_FOLDER=INBOX
MAIL_INBOUND_ENABLED=false

# ---- OAuth (optional, leave blank to disable social login) ----
OAUTH_REDIRECT_URI=<SET_IN_ENV>

# ---- Cloudflare Turnstile (CAPTCHA on login and reset) ----
# Get keys at: https://dash.cloudflare.com → Turnstile
# Leave CF_TURNSTILE_SECRET_KEY empty to disable verification in dev.
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=
CF_TURNSTILE_ENABLED=true

# ---- Cloudflare Tunnel ----
# DEFAULT (free): cloudflared runs a quick tunnel and shows a random
# *.trycloudflare.com URL in the container logs. No token required.
# CUSTOM DOMAIN (IDLE — costs money when enabled): set CUSTOM_DOMAIN_ENABLED=true
# below AND provide a named-tunnel token here.
CF_TUNNEL_TOKEN=

# ---- Backups ----
BACKUP_DIR=/var/backups/ict_ticketing

# ==============================================================================
# IDLE — costs money when enabled
# ------------------------------------------------------------------------------
# Every flag below ships DISABLED (false). The component's code still exists
# and is wired in, but it short-circuits before making any paid network call,
# consumes no paid resource, and needs no credentials. Set the flag to "true"
# to activate.
# ==============================================================================

# Nightly offsite copy of the newest local backup (via rclone; b2 = Backblaze B2).
# Approximate cost when enabled: provider storage (pay-per-GB) + egress.
OFFSITE_BACKUP_ENABLED=false
OFFSITE_BACKUP_PROVIDER=b2          # rclone remote name (create it with `rclone config`)
OFFSITE_BACKUP_REMOTE=b2:ict-backups

# Custom domain for the Cloudflare tunnel (subscription/free-tier limits).
# Approximate cost when enabled: ~$5/mo or Cloudflare free-tier limits.
CUSTOM_DOMAIN_ENABLED=false

# Sends app events to MONITORING_ENDPOINT when enabled (monitoring_hook.py).
# Approximate cost when enabled: the monitoring provider you point at.
MONITORING_ENABLED=false
MONITORING_ENDPOINT=                # e.g. https://your-host.example/v1/events
MONITORING_API_KEY=                 # optional, only if the endpoint requires it

# PAID web-push notifications (frontend idle stub, maybePushNotify).
# Approximate cost when enabled: push provider (e.g. OneSignal/APNs) fees.
PUSH_ENABLED=false
