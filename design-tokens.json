        },
        "titleLarge": {
          "value": "clamp(1.5rem, 1.25rem + 1.25vw, 2.25rem)",
          "description": "Section headers and primary modal titles"
        },
        "titleMedium": {
          "value": "clamp(1.2rem, 1.05rem + 0.75vw, 1.65rem)",
