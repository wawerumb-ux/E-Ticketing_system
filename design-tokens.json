      "fontWeight": {
        "regular": { "value": "400" },
        "medium": { "value": "500" },
        "semibold": { "value": "600" },
        "bold": { "value": "700" }
      }
    },
    "spacing": {
      "3xs": { "value": "0.25rem", "pixels": "4px" },
      "2xs": { "value": "0.5rem", "pixels": "8px" },
      "xs": { "value": "0.75rem", "pixels": "12px" },
      "sm": { "value": "1rem", "pixels": "16px" },
      "md": { "value": "1.5rem", "pixels": "24px" },
      "lg": { "value": "2rem", "pixels": "32px" },
      "xl": { "value": "3rem", "pixels": "48px" },
      "2xl": { "value": "4rem", "pixels": "64px" }
    },
    "elevation": {
      "surface-raised": {
        "value": "0 1px 2px rgba(15, 23, 42, 0.04), 0 1px 1px rgba(15, 23, 42, 0.02)",
        "description": "Hairline tactile lift"
      },
      "surface-floating": {
        "value": "0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04)",
        "description": "Editorial header, modal, and drawer floating shadow"
      },
      "surface-overlay": {
        "value": "0 25px 50px -12px rgba(15, 23, 42, 0.22)",
        "description": "Deep popover and notification layer"
      },
      "focus-ring": {
        "value": "0 0 0 3px rgba(37, 99, 235, 0.25)",
        "description": "High-visibility accessibility focus indicator"
      }
    },
    "radius": {
      "sm": { "value": "6px" },
      "md": { "value": "10px" },
      "lg": { "value": "16px" },
      "pill": { "value": "9999px" }
    },
    "motion": {
      "timing": {
        "instant": { "value": "100ms" },
        "swift": { "value": "180ms" },
        "deliberate": { "value": "280ms" }
      },
      "easing": {
        "spring": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "description": "Natural editorial spring rebound" },
        "standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "description": "Material acceleration-deceleration curve" },
        "sharp": { "value": "cubic-bezier(0.4, 0, 0.6, 1)", "description": "Immediate exit motion" }
      }
    },
    "layout": {
      "headerHeight": { "value": "72px" },
      "footerMinHeight": { "value": "160px" },
      "maxContentWidth": { "value": "1360px" }
    }
