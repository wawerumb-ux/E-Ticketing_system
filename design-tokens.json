        "surface-subtle": { "value": "#f8fafc", "description": "Subtle editorial warm off-white canvas (Slate 50)" },
        "surface-card": { "value": "#ffffff", "description": "Card and elevation panel background" },
        "surface-glass": { "value": "rgba(255, 255, 255, 0.85)", "description": "Translucent backdrop with blur" },
        "border": { "value": "#e2e8f0", "description": "Hairline architectural rule (Slate 200)" },
        "border-strong": { "value": "#cbd5e1", "description": "Deliberate boundary and input rule (Slate 300)" }
