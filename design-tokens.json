        },
        "bodyLarge": {
          "value": "clamp(1rem, 0.95rem + 0.25vw, 1.125rem)",
          "description": "Editorial lead paragraphs"
        },
        "body": {
          "value": "1rem",
          "description": "Standard 16px body text baseline"
        },
        "bodySmall": {
          "value": "0.875rem",
          "description": "Secondary descriptive annotations (14px)"
        },
        "caption": {
          "value": "0.75rem",
          "description": "Accessible legibility floor (12px minimum per TXT7)"
        }
      },
      "lineHeight": {
        "tight": { "value": "1.15" },
        "heading": { "value": "1.25" },
        "body": { "value": "1.55" },
        "relaxed": { "value": "1.75" }
