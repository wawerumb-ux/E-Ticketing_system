{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "E-Ticketing Editorial Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens engineered for offline-first, hyper-accessible, high-craft editorial interfaces.",
  "tokens": {
    "color": {
      "brand": {
        "primary": { "value": "#2563eb", "description": "High-contrast editorial sapphire blue" },
        "primary-dark": { "value": "#1d4ed8", "description": "Deep cobalt for interactive pressed states" },
        "primary-light": { "value": "#dbeafe", "description": "Tonal atmospheric tint for badges and halos" },
        "accent": { "value": "#f97316", "description": "Warm terracotta accent ink" },
        "accent-light": { "value": "#fff7ed", "description": "Subtle amber wash for highlighted items" },
        "brass": { "value": "#b9924a", "description": "Editorial brass metallic accent for seals and identity" }
      },
      "neutral": {
        "ink-strong": { "value": "#0f172a", "description": "Primary high-contrast typography ink (Slate 900)" },
        "ink-body": { "value": "#334155", "description": "Body prose reading ink (Slate 700)" },
        "ink-muted": { "value": "#64748b", "description": "Secondary metadata and caption ink (Slate 500)" },
        "ink-subtle": { "value": "#94a3b8", "description": "Tertiary iconography and subtle borders (Slate 400)" },
