      "semantic": {
        "success": {
          "ink": { "value": "#15803d", "description": "Emerald forest ink (WCAG AA compliant)" },
          "tint": { "value": "#dcfce7", "description": "Soft mint pill background" }
        },
        "warning": {
          "ink": { "value": "#b45309", "description": "Warm ochre ink (WCAG AA compliant)" },
          "tint": { "value": "#fef3c7", "description": "Ochre tone wash" }
        },
        "danger": {
          "ink": { "value": "#b91c1c", "description": "Crimson signal ink" },
          "tint": { "value": "#fee2e2", "description": "Signal alert tint" }
        },
        "info": {
          "ink": { "value": "#1d4ed8", "description": "Deep sky telemetry ink" },
          "tint": { "value": "#e0f2fe", "description": "Sky telemetry wash" }
        }
      }
    },
    "typography": {
      "fontFamily": {
        "display": {
          "value": "'Fraunces', Georgia, 'Times New Roman', serif",
          "description": "Editorial variable serif display stack (self-hosted OFL woff2)"
        },
        "sans": {
          "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
          "description": "System UI stack with zero network overhead"
        },
        "mono": {
          "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace",
          "description": "System monospace stack for ticket hashes and metrics"
        }
      },
      "fluidScale": {
        "display": {
          "value": "clamp(2.25rem, 1.8rem + 2.25vw, 3.5rem)",
